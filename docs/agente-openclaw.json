  "cards": [
    {
      "dot": "cyan",
      "title": "Compuertas antes del agente",
      "items": [
        "La firma, la deduplicación y la cola no cambian",
        "Sin «Acepto» de la Ley 1581 no se llama al gateway",
        "Los comandos con «/» no se reenvían al gateway"
      ]
    },
    {
      "dot": "rose",
      "title": "Datos personales",
      "items": [
        "El gateway recibe la huella HMAC wa:<huella>, nunca el número",
        "La traza pública de herramientas no lleva argumentos",
        "Token del gateway por entorno, sin valor por defecto"
      ]
    },
    {
      "dot": "emerald",
      "title": "Respaldo",
      "items": [
        "Sin reintentos: un reintento duplicaría el turno",
        "Timeout, error de red, 5xx o cuerpo vacío pasan al grafo",
        "Cada turno registra qué motor respondió: openclaw, grafo o canal"
      ]
    }
