    {
      "dot": "emerald",
      "title": "Todo local salvo el modelo",
      "items": [
        "FastAPI, Chroma, el CSV y SQLite viven en el equipo",
        "Ollama en 127.0.0.1:11434 calcula los embeddings",
        "DeepSeek solo recibe la pregunta y los fragmentos elegidos"
      ]
    },
    {
      "dot": "amber",
      "title": "Memoria y respuesta",
      "items": [
        "SqliteSaver aísla cada sesión por thread_id",
        "El grafo recorta el historial antes de redactar",
        "La respuesta cita la fuente Gold o la fila del Tablero"
      ]
