  "cards": [
    {
      "dot": "cyan",
      "title": "Rutas del Digiturno",
      "items": [
        "Cortesía → 0 tokens: saludo, gracias o identidad, sin recuperador ni modelo",
        "B → Bóveda: RAG sobre los fragmentos de Gold",
        "T → Tablero: 1–3 filas, respuesta con plantilla",
        "Mixta → Tablero + Bóveda: la cifra y su explicación en un turno",
        "Perfil → memoria de largo plazo: nombre y empresa del cliente",
        "X → rechazo: si el dato no está, no se inventa"
      ]
    },
    {
      "dot": "emerald",
      "title": "Todo local salvo el modelo",
      "items": [
        "FastAPI, Qdrant, el CSV y las dos SQLite viven en el equipo",
        "Ollama en 127.0.0.1:11434 calcula los embeddings",
        "DeepSeek solo recibe la pregunta y los fragmentos elegidos"
      ]
    },
    {
      "dot": "amber",
      "title": "Memoria en dos plazos",
      "items": [
        "Checkpointer: memoria.sqlite guarda el hilo completo por thread_id",
        "Store: perfil.sqlite guarda nombre y empresa por usuario, en su namespace",
        "El perfil no llega al modelo, a la caché ni al checkpointer",
        "Se borra con «olvida mi perfil»"
      ]
    },
    {
      "dot": "violet",
      "title": "Operación",
      "items": [
        "SSE en /api/preguntar/stream: una etapa por nodo, sin la pregunta",
        "GET /health responde 200 con índice o en demo; 503 si falta el índice",
        "Ctrl + C cierra en segundos aunque haya un stream abierto y deja libre el puerto",
        "LangSmith traza el turno solo si se activa por variables; por defecto está apagado"
      ]
    }
  ]
