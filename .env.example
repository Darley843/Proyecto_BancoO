# Valores de ejemplo del canal de WhatsApp.
#
# Este archivo NO se carga: el proyecto no lee `.env` (docs/SEGURIDAD.md §4).
# Copia cada variable a la sesión de PowerShell antes de arrancar:
#   $env:WHATSAPP_VERIFY_TOKEN = "..."
# Nunca escribas valores reales aquí ni en el repositorio.

WHATSAPP_VERIFY_TOKEN=<cadena-que-tu-eliges>
WHATSAPP_APP_SECRET=<app-secret-de-meta>
WHATSAPP_ACCESS_TOKEN=<token-permanente-de-meta>
WHATSAPP_PHONE_NUMBER_ID=<phone-number-id>
WHATSAPP_ID_SALT=<cadena-aleatoria-larga>
WHATSAPP_MODO=falso
