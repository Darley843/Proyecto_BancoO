# Entorno
.venv/
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Datos
# Bronze y Silver son reproducibles y pesados; Gold SI se versiona:
# es el entregable que consume el RAG del Modulo 2.
data/raw/
data/processed/
# Salidas del asistente (no versionadas: se generan con --salida).
data/asistente/
# Bases del canal, el diagnóstico, el red team y la latencia: se crean al usarlas.
data/asistente/whatsapp.sqlite
data/asistente/diagnostico.sqlite
data/asistente/roba.sqlite
data/asistente/latencias.sqlite
# Escena demo: JSON proyectado y núcleo; se regeneran con 'make escena-proyectada'.
data/escena/
# Indice vectorial de la Boveda (Qdrant local + metadatos): se regenera con 'make indice'.
data/boveda/
# Explicito aunque la carpeta padre ya este ignorada.
data/boveda/qdrant/
# chunks.jsonl (paginas + PDF + videos, ~43 MB) se regenera con 'make chunks'.
# chunks_web.jsonl (solo paginas web) y el conocimiento curado SI se versionan.
data/knowledge/chunks.jsonl
data/knowledge/draft-*.jsonl
.data/
.demo/
!data/gold/
!data/gold/**

# Secretos
.env
.env.*
!.env.example
*.token
*.pem

# Herramientas
.playwright/
node_modules/

# Sistema y editores
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# Logs
*.log
# Roba la Bóveda
data/asistente/roba_memoria.sqlite

# Voces de la escena (Piper): se descargan con `make voz-modelo`
data/modelos/

# Workspace local del agente pana (OpenClaw): memoria y bitácora nunca se
# versionan; solo viajan las plantillas .example.
openclaw/workspace/pana/MEMORY.md
openclaw/workspace/pana/memory/*.md
!openclaw/workspace/pana/memory/*.md.example
# Estado del gateway: sesiones y credenciales locales, fuera de Git.
openclaw/state/
