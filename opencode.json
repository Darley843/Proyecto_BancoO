{
  "mcp": {
    "servers": {
      "docs-langchain": {
        "type": "remote",
        "url": "https://docs.langchain.com/mcp"
      },
      "reference-langchain": {
        "type": "remote",
        "url": "https://reference.langchain.com/mcp"
      },
      "scrapling": {
        "type": "local",
        "command": [
          "uvx",
          "--from",
          "scrapling[ai,fetchers]>=0.5",
          "scrapling",
          "mcp"
        ]
      }
    }
  }
}
